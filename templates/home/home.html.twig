{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container mt-4">
    {% if app.user %}
        <div class="text-center">
            <h1>Bienvenue sur...</h1>
            <p class="lead">Gérez vos projets collaboratifs facilement et efficacement.</p>
            <a href="{{ path('app_projet_index') }}" class="btn btn-primary btn-lg">Voir les projets</a>
        </div>
        <div class="container mt-4">
            <h1 class="mb-5 text-center">Liste de vos projets</h1>
            <div class="row">
            {% for projet in app.user.projets %}
            <div class="col-md-4 mb-4"> 
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5>{{ projet.nom }}</h5>
                        <form action="{{ path('app_projet_delete', {'id': projet.id}) }}" method="POST" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ projet.id) }}">
                            {% if projet.creator != app.user %}
                                <button type="submit" class="btn btn-danger btn-sm mb-2 ms-2"><i class="bi bi-trash"></i></button>
                            {% endif %}
                        </form>
                    </div>
                    <div class="card-body">
                        <p><strong>Description :</strong> {{ projet.description }}</p>
                        <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-info-square"></i></a>
                        <a href="{{ path('app_tache_new', {'projet': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-patch-plus"></i></a>
                        <a href="{{ path('app_tache_index', {'projet': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-list-task"></i></a>
                        <p><strong>Membres du projet :</strong></p>
                        {% if projet.Membres is not empty %}
                            <ul class="list-unstyled mb-3">
                                {% for membre in projet.Membres %}
                                    <li>
                                        {{ membre.prenom }} {{ membre.nom }}
                                        {% if membre != app.user %}
                                            <form action="{{ path('app_projet_remove_member', {'projetId': projet.id, 'userId': membre.id}) }}" method="POST" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('remove_member' ~ projet.id ~ membre.id) }}">
                                                <button type="submit" class="btn btn-danger btn-sm ms-2"><i class="bi bi-person-dash"></i> Supprimer</button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p>Aucun membre</p>
                        {% endif %}
                        {# <p><strong>Nombre de tâches :</strong> {{ tasksCount(projet) }}</p> #}
                    </div>
                </div>
            </div>
            {% else %}
                <italic> Vous n'avez aucun projet encore </italic>
            {% endfor %}
        <div class="row text-center mt-4 mb-2">
            <div class="col-md-4 ">
                <i class="bi bi-kanban" style="font-size: 2rem;"></i>
                <h5>Gestion des projets</h5>
                <p>Suivez facilement et rapidement l'avancé de vos projets.</p>
            </div>
            <div class="col-md-4 ">
                <i class="bi bi-card-checklist" style="font-size: 2rem; "></i>
                <h5>Gestion des tâches</h5>
                <p>Organisez vos tâches avec des statuts et des échéances claires.</p>
            </div>
            <div class="col-md-4 ">
                <i class="bi bi-chat-dots" style="font-size: 2rem; "></i>
                <h5>Collaboration en temps réel</h5>
                <p>Communiquez facilement grâce au chat et aux commentaires.</p>
            </div>
        </div>
    {% else %}
        <div class="text-center">
            <h1>Bienvenue sur ...</h1>
            <p class="lead">Rejoignez-nous pour gérer vos projets facilement et rapidement.</p>
            <a href="{{ path('app_login') }}" class="btn btn-success btn-lg">Se connecter</a>
            <a href="{{ path('app_user_new') }}" class="btn btn-outline-primary btn-lg">Créer un compte</a>
        </div>
    {% endif %}
</div>
{% endblock %}
