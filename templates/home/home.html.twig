{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container mt-4">
    {% if app.user %}
        <div class="text-center">
            <h1>Bienvenue sur ...</h1>
            <p class="lead">Gérez vos projets collaboratifs facilement et efficacement.</p>
            <a href="{{ path('app_projet_index') }}" class="btn btn-primary btn-lg">Voir les projets</a>
        </div>
        <div class="row text-center mt-4">
            <div class="col-md-4">
                <i class="bi bi-kanban" style="font-size: 2rem;"></i>
                <h5>Gestion des projets</h5>
                <p>Suivez facilement et rapidement l'avancé de vos projets.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-card-checklist" style="font-size: 2rem;"></i>
                <h5>Gestion des tâches</h5>
                <p>Organisez vos tâches avec des statuts et des échéances claires.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-chat-dots" style="font-size: 2rem;"></i>
                <h5>Collaboration en temps réel</h5>
                <p>Communiquez facilement grâce au chat et aux commentaires.</p>
            </div>
        </div>
    {% else %}
        <div class="text-center">
            <h1>Bienvenue sur ...</h1>
            <p class="lead">Rejoignez-nous pour gérer vos projets en toute simplicité.</p>
            <a href="{{ path('app_login') }}" class="btn btn-success btn-lg">Se connecter</a>
            <a href="{{ path('app_user_new') }}" class="btn btn-outline-primary btn-lg">Créer un compte</a>
        </div>
    {% endif %}
</div>
{% endblock %}
