{% extends 'base.html.twig' %}

{% block title %}Hello GererSessionController!{% endblock %}

{% block body %}
    <div class="mt-3">
        <a href="{{ path('app_managing_session') }}" class="btn btn-outline-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                <path d="M177.5 414c-8.8 3.8-19 2-26-4.6l-144-136C2.7 268.9 0 262.6 0 256s2.7-12.9 7.5-17.4l144-136c7-6.6 17.2-8.4 26-4.6s14.5 12.5 14.5 22v72h288c17.7 0 32 14.3 32 32v64c0 17.7-14.3 32-32 32h-288v72c0 9.6-5.7 18.2-14.5 22z"/>
            </svg>
        <span class="ms-2">retour</span>
        </a>
    </div>
    <h1 class="text-center mb-4">Liste des utilisateurs</h1>

        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Matricule</th>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Service</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="text-center">
                            <td>{{ app.user.Matricule }}</td>
                            <td>{{ app.user.prenom }}</td>
                            <td>{{ app.user.Nom }}</td>
                            <td>{{ app.user.service }}</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="btn btn-danger btn-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" height="32" width="28" viewBox="0 0 448 512">
                                        <path d="M135.2 17.7L128 32 32 32C14.3 32 0 46.3 0 64S14.3 96 32 96l384 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-96 0-7.2-14.3C307.4 6.8 296.3 0 284.2 0L163.8 0c-12.1 0-23.2 6.8-28.6 17.7zM416 128L32 128 53.2 467c1.6 25.3 22.6 45 47.9 45l245.8 0c25.3 0 46.3-19.7 47.9-45L416 128z"/></svg>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="11" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
{% endblock %}
