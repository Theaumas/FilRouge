{% extends 'base.html.twig' %}

{% block title %}Modifier le Projet{% endblock %}

{% block style %}
<style>
    .form-check {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .form-check-label {
        margin-right: 15px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-control {
        border-radius: 0.375rem;
    }

    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 0.375rem;
    }

    .card-body {
        padding: 2rem;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
        padding: 0.5rem 1.5rem;
        border-radius: 0.375rem;
        font-size: 1rem;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .card-header {
        font-weight: bold;
        font-size: 1.2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-bottom: 1px solid #e0e0e0;
    }

    .card-footer {
        padding: 1rem;
        text-align: right;
    }

    .card-body .form-label {
        font-weight: bold;
    }

    .btn-back {
        margin-bottom: 20px;
    }

</style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <a href="{{ path('app_projet_index', {'projet': projet.id}) }}" class="btn btn-outline-dark mt-3 ms-3 btn-back">
        <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
            <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>
        Retour
    </a>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1>Modifier le Projet "{{ projet.nom }}"</h1>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2 mb-3">
            {{ form_start(form) }}
                <div class="card">
                    <div class="card-body">
                        <div class="form-group mb-3">
                            {{ form_label(form.nom, null, {'label_attr': {'class': 'font-weight-bold'}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'font-weight-bold'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                            {{ form_label(form.dateLimite, null, {'label_attr': {'class': 'font-weight-bold'}}) }}
                            {{ form_widget(form.dateLimite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                            {{ form_label(form.statut, null, {'label_attr': {'class': 'font-weight-bold'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Modifier le Projet</button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
