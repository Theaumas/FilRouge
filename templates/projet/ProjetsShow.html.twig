{% extends 'base.html.twig' %}

{% block style %}
    <style>
        .project-details {
            text-align: center;
            margin-top: 50px;
        }

        .card {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            background-color: #f9f9f9;
        }

        .card-header {
            background-color: #343a40;
            color: white;
            padding: 15px;
            border-radius: 8px 8px 0 0;
        }

        .card-body {
            padding: 20px;
        }

        .card-footer {
            margin-top: 20px;
        }

        .btn {
            margin: 5px;
        }

        .task-count {
            font-size: 18px;
            font-weight: bold;
            margin-top: 10px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-end me-4">
        <a href="{{ path('app_projet_affecter', {'projetId': projet.id}) }}" class="text-decoration-none">
            <i class="fs-1 bi bi-person-add text-primary"></i>
        </a>
    </div>

    <div class="project-details mb-3">
        <div class="card">
            <div class="card-header">
                <h2>{{ projet.nom }}</h2>
            </div>
            <div class="card-body">
                <p><strong>Description :</strong> {{ projet.description }}</p>
                <p><strong>Statut :</strong> {{ projet.statut.label }}</p>
                <p><strong>Date limite :</strong> {{ projet.dateLimite ? projet.dateLimite|date('Y-m-d') : 'Non définie' }}</p>

                <p><strong>Membres :</strong></p>
                {% if projet.Membres is not empty %}
                    <ul class="list-unstyled">
                        {% for membre in projet.Membres %}
                            <li>
                                {{ membre.prenom }} {{ membre.nom }}
                                {% if membre != app.user %}
                                    <form action="{{ path('app_projet_remove_member', {'projetId': projet.id, 'userId': membre.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_member' ~ projet.id ~ membre.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm ms-2"><i class="bi bi-person-dash"></i> Supprimer</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p>Aucun membre</p>
                {% endif %}

                <div class="task-count">
                    <p>Nombre de tâches associées :</p> {{ tacheCount }}
                </div>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_projet_edit', {'id': projet.id, 'userId': user.id }) }}" class="btn btn-warning">Modifier</a>
                <a href="{{ path('app_tache_index', {'projet': projet.id}) }}" class="btn btn-primary">Taches du Projet </a>
                <a href="{{ path('app_projet_index') }}" class="btn btn-secondary">Retour aux Projets </a>
            </div>
        </div>
    </div>
{% endblock %}
