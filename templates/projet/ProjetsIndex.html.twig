{% extends 'base.html.twig' %}

{% block style %}
    <style>
        .card {
            transition: all 0.3s;
        }
        .card:hover {
            transform: scale(1.15);
        }
    </style>
{% endblock %}

{% block title %}Liste des projets{% endblock %}

{% block body %}
<a href="{{ path('app_projet_new') }}" class="btn btn-success mt-4 ms-4">Créer un nouveau projet</a>
<div class="container mt-4">
    <h1 class="mb-4">Liste des projets</h1>
    <div class="row">
        {% for projet in app.user.projets %}
            <div class="col-md-4 mb-4"> 
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5>{{ projet.nom }}</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Description :</strong> {{ projet.description }}</p>
                        <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-info-square"></i></a>
                        <a href="{{ path('app_tache_new', {'projet': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-patch-plus"></i></a>
                        <a href="{{ path('app_tache_show', {'projet': projet.id}) }}" class="btn btn-primary btn-sm"><i class="bi bi-list-task"></i></a>
                        <p><strong>Membres :</strong></p>
                        {% if projet.Membres is not empty %}
                            <ul class="list-unstyled">
                                {% for membre in projet.Membres %}
                                    <li>{{ membre.prenom }} {{ membre.nom }}</li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p>Aucun membre</p>
                        {% endif %}
                    </div>
                    <form action="{{ path('app_projet_delete', {'id': projet.id}) }}" method="POST" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ projet.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm mb-2 ms-2"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
        {% else %}
            <p>Aucun projet disponible.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
