{% extends 'base.html.twig' %}

{% block title %}Créer un Nouveau Projet {% endblock %}

{% block style %}
    <style>
        .container {
            margin-top: 30px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-control {
            border-radius: 5px;
            padding: 10px;
        }
        .btn-primary {
            padding: 10px;
            font-size: 16px;
        }
        .card {
            transition: none;
            transform: none ;
            box-shadow: none;
            border: 1px solid #ddd; 
        }
    </style>
{% endblock %}


{% block body %}
    <a href="{{ path('app_projet_index') }}" class="btn btn-outline-dark mt-3 ms-3">  
        <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
            <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>
        Retour
    </a>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8">
                <h1 class="text-center mb-4">Créer un Nouveau Projet</h1>

                {{ form_start(form) }}
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="form-group mb-3">
                                <strong>{{ form_label(form.nom, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="form-group mb-3">
                                <strong>{{ form_label(form.description, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="form-group mb-3">
                                <strong>{{ form_label(form.dateLimite, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                                {{ form_widget(form.dateLimite, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="form-group mb-3">
                                <strong>{{ form_label(form.statut, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Créer</button>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
