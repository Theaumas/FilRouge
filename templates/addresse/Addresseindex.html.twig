{% extends 'base.html.twig' %}

{% block title %}Adresse du Compte{% endblock %}

{% block body %}
<div class="container mt-4">

    <a href="{{ path('app_user_index') }}" class="btn btn-outline-dark mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
            <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>Retour
    </a>

    <h1 class="text-center mb-4">Adresses du Compte</h1>

    <div class="row">
        {% for addresse in app.user.addresses %}
            <div class="col-md-4">
                <a href="{{ path('app_addresse_show', {'id': addresse.id}) }}" class="text-decoration-none text-dark">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="card-title">{{ addresse.titre }}</h5>
                            <p class="card-text">
                                <strong>Ville :</strong> {{ addresse.Ville }}<br>
                                <strong>Code Postal :</strong> {{ addresse.CodePostal }}<br>
                                <strong>Pays :</strong> {{ addresse.Pays }}
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center">Aucune adresse disponible.</p>
            </div>
        {% endfor %}
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_addresse_new') }}" class="btn btn-success">Ajouter une adresse</a>
    </div>
</div>
{% endblock %}
