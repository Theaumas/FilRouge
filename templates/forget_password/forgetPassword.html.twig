{% extends 'base.html.twig' %}

{% block title %}Mot de Passe Oublié !{% endblock %}

{% block body %}
    <a href="{{ path('app_home') }}" class="btn btn-outline-dark mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
            <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>Retour
    </a>

    <h1> Mot de Passe Oublié</h1>

    {{form(forgetPassword)}}

    <div>Vous avez déja un compte ? <a href='{{ path('app_login') }}'> Connectez-vous </a></div>

    {% for message in app.flashes('success') %}
    <div class="text-center w-75 mx-auto bg-info">
        {{ message }}
    </div>
    {% endfor %}

{% endblock %}
