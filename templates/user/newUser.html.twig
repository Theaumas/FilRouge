{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block style %}
    <style>
        .form-container {
            max-width: 600px;
            width: 100%;
            padding: 20px;
            margin-top : 10px
        }
        
        .form-container .card {
            border: 1px solid #ddd;
            border-radius: 10px;
        }

        .form-control {
            border-radius: 5px;
            padding: 10px;
        }

        .btn-primary {
            padding: 10px;
            font-size: 16px;
            margin-top : 10px
        }
    </style>
{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center">
    <div class="form-container">
        <div class="card p-4 ">
            <h1 class="h4 mb-4 text-center">Inscription</h1>
            
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                    </div>
                    <div class="col-md-6 form-group">
                        {{ form_label(form.matricule) }}
                        {{ form_widget(form.matricule) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_label(form.Prenom) }}
                        {{ form_widget(form.Prenom) }}
                    </div>
                    <div class="col-md-6 form-group">
                        {{ form_label(form.Nom) }}
                        {{ form_widget(form.Nom) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_label(form.Tel) }}
                        {{ form_widget(form.Tel) }}
                    </div>
                    <div class="col-md-6 form-group">
                        {{ form_label(form.service) }}
                        {{ form_widget(form.service) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_label(form.photo) }}
                        {{ form_widget(form.photo) }}
                    </div>
                    <div class="col-md-6 form-group">
                        {{ form_label(form.DateDeNaissance) }}
                        {{ form_widget(form.DateDeNaissance) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_label(form.password.first) }}
                        {{ form_widget(form.password.first) }}
                    </div>
                    <div class="col-md-6 form-group">
                        {{ form_label(form.password.second) }}
                        {{ form_widget(form.password.second) }}
                    </div>
                </div>

                <button class="btn btn-primary w-100" type="submit">S'inscrire</button>

            {{ form_end(form) }}

            <div class="mt-3 text-center">
                <small>Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></small>
            </div>
        </div>
    </div>
</div>
{% endblock %}
