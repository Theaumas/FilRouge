{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block style %}
    <style>
        .form-container {
            max-width: 600px;
            width: 100%;
            padding: 20px;
        }

        .form-container .card {
            border: 1px solid #ddd;
            border-radius: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            border-radius: 5px;
            padding: 10px;
        }

        .btn-primary {
            padding: 10px;
            font-size: 16px;
        }

        @media (max-width: 768px) {
            .row .col-md-6 {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center">
    <div class="form-container">
        <div class="card p-4 shadow-sm">
            <h1 class="h4 mb-4 text-center">Inscription</h1>
            
            {{ form_start(form) }}
            
            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_row(form.email) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_row(form.matricule) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_row(form.Prenom) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_row(form.Nom) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_row(form.Tel) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_row(form.service) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_row(form.photo) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_row(form.DateDeNaissance) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_row(form.password.first) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_row(form.password.second) }}
                </div>
            </div>

            <button class="btn btn-primary w-100" type="submit">S'inscrire</button>

            {{ form_end(form) }}

            <div class="mt-3 text-center">
                <small>Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></small>
            </div>
        </div>
    </div>
</div>
{% endblock %}
