{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4 shadow-sm" style="width: 100%;">
        <h1 class="h4 mb-4 text-center">Inscription</h1>
        {{ form_start(form) }}
        
        <div class="row">
            <div class="col-md-6">
            {{ form_row(form.email) }}
                
            </div>
            <div class="col-md-6">
                {{ form_row(form.matricule) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.Prenom) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.Nom) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.Tel) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.service) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
             {{ form_row(form.photo) }}
            </div>
            <div class="col-md-6">
              {{ form_row(form.DateDeNaissance) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.password.first) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.password.second) }}
            </div>
        </div>

        <button class="btn btn-primary w-100" type="submit">S'inscrire</button>

        {{ form_end(form) }}

        <div class="mt-3 text-center">
            <small>Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></small>
        </div>
        
    </div>
</div>
{% endblock %}
