{% extends 'base.html.twig' %}

{% block title %}Profil Complet{% endblock %}

{% block body %}
<div class="container mt-4">
    <a href="{{ path('app_user_index', {'id': app.user.id}) }}" class="btn btn-outline-dark mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
            <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
        </svg>
        Retour
    </a>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="text-primary">Profil</h1>
        <a href="{{ path('app_user_edit', {'id': app.user.id}) }}" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" width="32" viewBox="0 0 512 512">
                <path fill="#ffffff" d="M441 58.9L453.1 71c9.4 9.4 9.4 24.6 0 33.9L424 134.1 377.9 88 407 58.9c9.4-9.4 24.6-9.4 33.9 0zM209.8 256.2L344 121.9 390.1 168 255.8 302.2c-2.9 2.9-6.5 5-10.4 6.1l-58.5 16.7 16.7-58.5c1.1-3.9 3.2-7.5 6.1-10.4zM373.1 25L175.8 222.2c-8.7 8.7-15 19.4-18.3 31.1l-28.6 100c-2.4 8.4-.1 17.4 6.1 23.6s15.2 8.5 23.6 6.1l100-28.6c11.8-3.4 22.5-9.7 31.1-18.3L487 138.9c28.1-28.1 28.1-73.7 0-101.8L474.9 25C446.8-3.1 401.2-3.1 373.1 25zM88 64C39.4 64 0 103.4 0 152L0 424c0 48.6 39.4 88 88 88l272 0c48.6 0 88-39.4 88-88l0-112c0-13.3-10.7-24-24-24s-24 10.7-24 24l0 112c0 22.1-17.9 40-40 40L88 464c-22.1 0-40-17.9-40-40l0-272c0-22.1 17.9-40 40-40l112 0c13.3 0 24-10.7 24-24s-10.7-24-24-24L88 64z"/>
            </svg>
            Modifier le profil
        </a>
    </div>

    <div class="row">
        <div class="col-md-3 text-center">
            <img class="img-fluid img-thumbnail rounded shadow-sm w-75" 
                src="{{ app.user.photo is not empty ? asset(app.user.photo) : asset('assets/images/default-avatar.jpg') }}" 
                alt="Photo de profil">
        </div>

        <div class="col-md-9">
            <table class="table table-bordered table-hover shadow-sm">
                <tbody>
                    <tr>
                        <th class="bg-dark text-white">Matricule</th>
                        <td>{{ user.matricule }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Prénom</th>
                        <td>{{ user.Prenom }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Nom</th>
                        <td>{{ user.Nom }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Email</th>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Date de Naissance</th>
                        <td>{{ user.DateDeNaissance ? user.DateDeNaissance|date('d/m/Y') : 'Non renseigné' }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Téléphone</th>
                        <td>{{ user.Tel }}</td>
                    </tr>
                    <tr>
                        <th class="bg-dark text-white">Service</th>
                        <td>{{ user.service }}</td>
                    </tr>
                </tbody>
            </table>       
            <div class="mt-4 mb-4 text-end">
                {{ include('user/deleteUser.html.twig') }}
            </div>
        </div>
    </div>

</div>
{% endblock %}
