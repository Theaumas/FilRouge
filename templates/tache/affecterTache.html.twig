{% extends 'base.html.twig' %}

{% block title %}Affecter membres{% endblock %}

{% block body %}
<div class="container mt-4">
   <a href="{{ path('app_tache_show', {'projet': projet.id, 'id': tache.id}) }}" class="btn btn-outline-dark mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
                <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
            </svg>
            Retour
    </a>
    <div class="row">

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h3 class="text-center">Filtrer</h3>
                {{ form(f) }}
            </div>
        </div>

        <div class="col-md-9">
            <h2 class="mb-3">Employés</h2>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                {% for user in users %}
                    <div class="col">
                        <div class="card h-100 shadow-sm text-center">
                            <img src="{{ user.photo is not empty ? asset(user.photo) : asset('assets/images/default-avatar.jpg') }}" 
                                 class="card-img-top rounded-circle mx-auto mt-3"
                                 alt="Photo de {{ user.Prenom }}"
                                 style="width: 100px; height: 100px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">{{ user.matricule }}</h5>
                                <p class="card-text">{{ user.Prenom }}</p>
                                
                                {% if user in tache.users %} 
                                    <button class="btn btn-secondary" disabled>Déjà ajouté</button>
                                {% else %}
                                    <a href="{{ path('app_tache_ajouter_membre', {'projetId': projet.id, 'tacheId': tache.id, 'userId': user.id}) }}" class="btn btn-outline-info">
                                        Ajouter à la tâche
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
