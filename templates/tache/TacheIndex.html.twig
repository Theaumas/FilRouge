{% extends 'base.html.twig' %}

{% block style %}
    <style>
        .card {
            transition: all 0.3s;
        }
        .card:hover {
            transform: scale(1.05);
        }
        .task-actions {
            display: flex;
            gap: 5px;
            justify-content: flex-end;
        }
    </style>
{% endblock %}

{% block title %}Liste des tâches{% endblock %}

{% block body %}
    <a href="{{ path('app_projet_index', {'projet': projet.id}) }}" class="btn btn-outline-dark mb-3">  
            <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
                <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
            </svg>
            Retour
    </a>
<h1 class="mb-4">Liste des tâches pour le projet {{ projet.nom }}</h1>
    

<a href="{{ path('app_tache_new', {'projet': projet.id}) }}" class="btn btn-success mb-4">Ajouter une tâche</a>

<div class="row">
    {% for tache in taches %}
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5>{{ tache.titre }}</h5>
                </div>
                <div class="card-body">
                    <p><strong>Statut :</strong> {{ tache.statut }}</p>
                    {% if tache.user %}
                        <p><strong>Attribuée à :</strong> {{ tache.user.nom }} {{ tache.user.prenom }}</p>
                    {% else %}
                        <p><strong>Attribuée à :</strong> Aucun utilisateur</p>
                    {% endif %}
                    <div class="task-actions">
                        <a href="{{ path('app_tache_edit', {'projet': projet.id, 'id': tache.id}) }}" class="btn btn-warning btn-sm">
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_tache_delete', {'projet': projet.id, 'id': tache.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tache.id) }}"/>
                            <button class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p>Aucune tâche trouvée.</p>
    {% endfor %}
</div>

<a href="{{ path('app_projet_index') }}" class="btn btn-secondary mt-4">Retour aux projets</a>
{% endblock %}
