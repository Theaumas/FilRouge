{% extends 'base.html.twig' %}

{% block style %}
    <style>
        .card {
            transition: all 0.3s;
            min-height: 200px; /* Assure une hauteur uniforme */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card:hover {
            transform: scale(1.05);
        }
        .task-actions {
            display: flex;
            gap: 5px;
            justify-content: flex-end;
        }
        .user-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
    </style>
{% endblock %}

{% block title %}Tâche {{ tache.titre }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-end me-4">
        <a href="{{ path('app_tache_affecter', {'projetId': projet.id, 'tacheId': tache.id}) }}" class="text-decoration-none">
            <i class="fs-1 bi bi-person-add text-primary"></i>
        </a>
    </div>

    <div class="container mt-4">
        <a href="{{ path('app_tache_index', {'projet': projet.id}) }}" class="btn btn-outline-dark mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
                <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
            </svg>
            Retour aux Tâches
        </a>

        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5>{{ tache.titre }}</h5>
                <span class="badge bg-{{ tache.statut == 'Terminé' ? 'success' : 'warning' }} text-white">{{ tache.statut }}</span>
            </div>
           <div class="card-body">
                <p><strong>Description :</strong> {{ tache.description }}</p>
                <p><strong>Statut :</strong> {{ tache.statut }}</p>
                <p><strong>Attribuée à :</strong></p>
                {% if tache.getUsers() is not empty %}
                    <div class="user-actions">
                        <ul class="list-group">
                            {% for user in tache.getUsers() %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>{{ user.prenom }} {{ user.nom }}</span>
                                    {% if user != app.user %}
                                        <form action="{{ path('app_tache_remove_membre', {'tacheId': tache.id, 'userId': user.id, 'projetId': projet.id}) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('remove_member' ~ tache.id ~ user.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm ms-2"><i class="bi bi-person-dash"></i> Supprimer</button>
                                        </form>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% else %}
                    <p><span>Aucun utilisateur assigné</span></p>
                {% endif %}
            </div>

        </div>
    </div>
{% endblock %}
