{% extends 'base.html.twig' %}

{% block title %}Ajouter une nouvelle tâche{% endblock %}

{% block body %}
        <div class="container mt-4">
            <a href="{{ path('app_tache_index', {'projet': projet.id}) }}" class="btn btn-outline-dark mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" height="24" width="21" viewBox="0 0 448 512">
                    <path fill="#000000" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                </svg>
                Retour
            </a>

    <div class="d-flex justify-content-between mb-4">
        <h1>Ajouter une nouvelle tâche au projet "{{ projet.nom }}"</h1>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2 mb-3">
            {{ form_start(form) }}
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <strong>{{ form_label(form.titre, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                            <strong>{{ form_label(form.description, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                           <strong> {{ form_label(form.dateLimite, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                            {{ form_widget(form.dateLimite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group mb-3">
                           <strong> {{ form_label(form.statut, null, {'label_attr': {'class': 'font-weight-bold'}}) }}</strong>
                            {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <button type="submit" class="btn btn-success mt-3 w-100">Ajouter la tâche</button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}