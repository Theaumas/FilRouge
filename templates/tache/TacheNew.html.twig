{% extends 'base.html.twig' %}

{% block title %}Ajouter une nouvelle tâche{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Ajouter une nouvelle tâche au projet "{{ projet.nom }}"</h1>

    {{ form_start(form) }}
        <div class="form-group">
            {{ form_row(form.titre) }}
        </div>
        <div class="form-group">
            {{ form_row(form.description) }}
        </div>
        <div class="form-group">
            {{ form_row(form.dateLimite) }}
        </div>
        <div class="form-group">
            {{ form_row(form.statut) }}
        </div>
        <button class="btn btn-success">Ajouter la tâche</button>
    {{ form_end(form) }}

    <a href="{{ path('app_tache_index', {'projet': projet.id}) }}" class="btn btn-secondary mt-4">Retour aux Tâches</a>
    <a href="{{ path('app_projet_index', {'projet': projet.id}) }}" class="btn btn-secondary mt-4">Retour aux Projets</a>
</div>
{% endblock %}
